@model List<_66076431_natalee.ViewModels.ProductOrderListViewModel>
@{
    Layout = "_BraLayout";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<style>
    body {
        background: #f5f5f5;
        color: #212529;
        font-family: 'Segoe UI', sans-serif;
    }

    /* Header */
    .dash-header {
        background: linear-gradient(135deg, #ed1c24, #c81017);
        color: #fff;
        padding: 24px 32px 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        box-shadow: 0 2px 10px rgba(0,0,0,.18);
        border-radius: 0 0 16px 16px;
        margin-bottom: 24px;
    }

    .dash-header h1 {
        margin: 0;
        font-size: 1.5rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .dash-header p {
        margin: 4px 0 0;
        font-size: .85rem;
        opacity: .9;
    }

    .badge-staff {
        background: rgba(255,255,255,.15);
        border: 1px solid rgba(255,255,255,.35);
        border-radius: 20px;
        padding: 6px 14px;
        font-size: .8rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    /* Card table */
    .order-card {
        border: none;
        border-radius: 16px;
        box-shadow: 0 4px 15px rgba(0,0,0,.08);
        overflow: hidden;
        background: #fff;
    }

    .table {
        margin-bottom: 0;
    }

    .table thead th {
        background: #f1f3f5;
        color: #495057;
        font-size: .9rem;
        font-weight: 700;
        border-bottom: 1px solid #dee2e6;
        white-space: nowrap;
    }

    .table tbody td {
        vertical-align: middle;
        color: #212529;
        font-size: .9rem;
    }

    .table tbody tr:hover {
        background: #fff3f2;
    }

    /* Status badges */
    .badge-status {
        font-size: .85rem;
        padding: 5px 12px;
        border-radius: 12px;
        font-weight: 600;
        display: inline-block;
    }

    .badge-wait { background: #ffe8a1; color: #856404; }
    .badge-shipping { background: #cce5ff; color: #084298; }
    .badge-success { background: #d4edda; color: #155724; }
    .badge-other { background: #e2e3e5; color: #6c757d; }

    /* Actions */
    .action-group {
        display: flex;
        gap: 8px;
        justify-content: center;
        flex-wrap: wrap;
    }

    .btn-action {
        border-radius: 999px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 14px;
        transition: all .2s;
        box-shadow: 0 2px 6px rgba(0,0,0,.1);
    }

    .btn-detail {
        background: #0d6efd;
        border: none;
        color: #fff;
    }

    .btn-detail:hover {
        background: #0b5ed7;
        transform: translateY(-1px);
    }

    .btn-start-shipping {
        background: #ffc107;
        border: none;
        color: #212529;
    }

    .btn-start-shipping:hover {
        background: #e0a800;
        transform: translateY(-1px);
    }

    .btn-complete-shipping {
        background: #198754;
        border: none;
        color: #fff;
    }

    .btn-complete-shipping:hover {
        background: #157347;
        transform: translateY(-1px);
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .dash-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 12px;
        }

        .dash-header h1 {
            font-size: 1.25rem;
        }

        .table-responsive {
            overflow-x: auto;
        }

        .action-group {
            flex-direction: column;
        }
    }
</style>

<div class="dash-header">
    <div>
        <h1>
            <i class="bi bi-card-checklist"></i>
            <span>รายการออเดอร์ (คลังสินค้า)</span>
        </h1>
        <p>@DateTime.Now.ToString("dd/MM/yyyy HH:mm")</p>
    </div>
    <span class="badge-staff">
        <i class="bi bi-person-badge"></i>
        <span>พนักงาน</span>
    </span>
</div>

<div class="card order-card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-bordered align-middle text-center">
                <thead>
                    <tr>
                        <th>เลขออเดอร์</th>
                        <th>ลูกค้า</th>
                        <th>วันที่</th>
                        <th>สถานะ</th>
                        <th>จัดการ</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.OrderNo</td>
                                <td>@item.CustomerName</td>
                                <td>@item.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    @{
                                        string badgeClass = item.Status switch
                                        {
                                            "รอจัดส่ง" => "badge-status badge-wait",
                                            "กำลังจัดส่ง" => "badge-status badge-shipping",
                                            "ส่งสำเร็จ" => "badge-status badge-success",
                                            _ => "badge-status badge-other"
                                        };
                                    }
                                    <span class="@badgeClass">@item.Status</span>
                                </td>
                                <td>
                                    <div class="action-group">
                                        <a asp-controller="Electrical" asp-action="OrderDetail" asp-route-orderId="@item.OrderId"
                                            class="btn btn-sm btn-detail btn-action">
                                            <i class="bi bi-eye"></i> <span>ดูรายละเอียด</span>
                                        </a>
                                        @if (item.Status == "รอจัดส่ง")
                                        {
                                            <a asp-controller="Electrical" asp-action="StartShipping" asp-route-orderId="@item.OrderId"
                                                class="btn btn-sm btn-start-shipping btn-action">
                                                <i class="bi bi-truck"></i> <span>ส่งให้ขนส่งแล้ว</span>
                                            </a>
                                        }
                                        else if (item.Status == "กำลังจัดส่ง")
                                        {
                                            <a asp-controller="Electrical" asp-action="CompleteShipping" asp-route-orderId="@item.OrderId"
                                                class="btn btn-sm btn-complete-shipping btn-action">
                                                <i class="bi bi-check-circle"></i> <span>ส่งสำเร็จ</span>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">
                                ยังไม่มีออเดอร์ที่ผ่านการตรวจสอบ
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>