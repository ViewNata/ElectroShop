@model List<_66076431_natalee.ViewModels.AddAdminViewModel>
@{
    Layout = "_BraLayout";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<style>
    body {
        background: #f5f5f5;
        font-family: 'Segoe UI', sans-serif;
        color: #212529;
    }

    /* ===== HEADER ===== */
    .dash-header {
        background: linear-gradient(135deg, #ed1c24, #c81017);
        color: #fff;
        padding: 24px 32px 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        box-shadow: 0 2px 8px rgba(0,0,0,.18);
        border-radius: 0 0 16px 16px;
        margin-bottom: 24px;
    }

    .dash-header h1 {
        margin: 0;
        font-size: 1.5rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .dash-header p {
        margin: 4px 0 0;
        font-size: .85rem;
        opacity: .9;
    }

    .badge-staff {
        background: rgba(255,255,255,.15);
        border: 1px solid rgba(255,255,255,.35);
        border-radius: 20px;
        padding: 6px 14px;
        font-size: .8rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    /* ===== CARD ===== */
    .admin-card {
        background: #fff;
        border: 1px solid #e9ecef;
        border-radius: 16px;
        box-shadow: 0 2px 10px rgba(0,0,0,.06);
        overflow: hidden;
    }

    .admin-card .card-body {
        padding: 24px;
    }

    /* ===== TABLE ===== */
    .table {
        margin-bottom: 0;
    }

    .table thead th {
        background: #f8f9fa;
        color: #495057;
        font-weight: 700;
        border-bottom: 1px solid #dee2e6;
        padding: 12px;
        white-space: nowrap;
    }

    .table tbody td {
        vertical-align: middle;
        padding: 12px;
        border-color: #eef0f4;
    }

    .table tbody tr:hover {
        background: #fff8f8;
    }

    .admin-id {
        font-weight: 600;
        color: #ed1c24;
    }

    .role-badge {
        display: inline-block;
        background: #ffe5e5;
        color: #c81017;
        padding: 5px 12px;
        border-radius: 999px;
        font-size: .8rem;
        font-weight: 600;
    }

    /* ===== ACTION ===== */
    .action-link {
        text-decoration: none;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: .2s;
    }

    .action-edit {
        color: #d97706;
    }

    .action-edit:hover {
        color: #b45309;
        text-decoration: underline;
    }

    .action-delete {
        color: #dc3545;
    }

    .action-delete:hover {
        color: #b02a37;
        text-decoration: underline;
    }

    /* ===== ADD BUTTON ===== */
    .btn-add {
        background: #ed1c24;
        border: none;
        border-radius: 999px;
        padding: 10px 18px;
        font-weight: 600;
        color: #fff;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .btn-add:hover {
        background: #c81017;
        color: #fff;
    }

    .table-responsive {
        border-radius: 14px;
        overflow: hidden;
    }

    @@media (max-width: 768px) {
        .dash-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 12px;
        }

        .dash-header h1 {
            font-size: 1.25rem;
        }

        .admin-card .card-body {
            padding: 16px;
        }
    }
</style>

<div class="dash-header">
    <div>
        <h1>
            <i class="bi bi-people"></i>
            <span>รายชื่อพนักงาน</span>
        </h1>
        <p>อัปเดตล่าสุด: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</p>
    </div>
    <span class="badge-staff">
        <i class="bi bi-person-badge"></i>
        <span>พนักงาน</span>
    </span>
</div>

<div class="card admin-card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table align-middle text-center">
                <thead>
                    <tr>
                        <th>AdminId</th>
                        <th>ชื่อ</th>
                        <th>อีเมล</th>
                        <th>เบอร์โทร</th>
                        <th>ตำแหน่ง</th>
                        <th>แก้ไข</th>
                        <th>ลบ</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="admin-id">@item.AdminId</td>
                                <td>@item.AdminName</td>
                                <td>@item.AdminEmail</td>
                                <td>@item.AdminPhone</td>
                                <td>
                                    <span class="role-badge">@item.AdminRole</span>
                                </td>
                                <td>
                                    <a asp-controller="Electrical"  asp-action="EditAdmin" asp-route-AID="@item.AdminId"
                                        class="action-link action-edit">
                                        <i class="bi bi-pencil-square"></i>
                                        <span>แก้ไข</span>
                                    </a>
                                </td>
                                <td>
                                    <a asp-controller="Electrical" asp-action="DeleteAdmin" asp-route-AID="@item.AdminId"
                                        class="action-link action-delete"
                                        onclick="return confirm('ลบพนักงานคนนี้?')">
                                        <i class="bi bi-trash3"></i>
                                        <span>ลบ</span>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-muted py-4">
                                ยังไม่มีข้อมูลพนักงาน
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="text-end mt-4">
            <a asp-controller="Electrical"
               asp-action="AddUser"
               class="btn btn-add">
                <i class="bi bi-plus-circle"></i>
                <span>เพิ่มพนักงาน</span>
            </a>
        </div>
    </div>
</div>