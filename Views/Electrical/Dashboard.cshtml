@model _66076431_natalee.ViewModels.DashboardViewModel
@{
    Layout = "_BraLayout";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<style>
    :root {
        --primary: #ed1c24;
        --primary-dark: #c81017;
        --primary-soft: #fff1f1;
        --success: #198754;
        --warning: #ffc107;
        --danger: #dc3545;
        --gray-50: #f8f9fa;
        --gray-100: #f3f4f6;
        --gray-200: #e5e7eb;
        --gray-300: #dee2e6;
        --gray-700: #495057;
        --gray-900: #212529;
        --white: #ffffff;
        --black: #000000;
    }

    body {
        background: var(--gray-100);
        font-family: 'Segoe UI', sans-serif;
        color: var(--gray-900);
    }

    /* ===== HEADER BAR ===== */
    .dash-header {
        background: linear-gradient(135deg, var(--primary), var(--primary-dark));
        color: var(--white);
        padding: 24px 32px 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        box-shadow: 0 2px 8px rgba(0,0,0,.18);
    }

    .dash-header h1 {
        margin: 0;
        font-size: 1.5rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .dash-header p {
        margin: 4px 0 0;
        font-size: .85rem;
        opacity: .9;
    }

    .badge-staff {
        background: rgba(255,255,255,.15);
        border: 1px solid rgba(255,255,255,.35);
        border-radius: 20px;
        padding: 6px 14px;
        font-size: .8rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    /* ===== WRAPPER ===== */
    .dash-body {
        padding: 28px 32px;
    }

    /* ===== KPI CARDS ===== */
    .kpi-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 18px;
        margin-bottom: 28px;
    }

    .kpi-card {
        background: var(--white);
        border-radius: 14px;
        padding: 22px 20px;
        box-shadow: 0 1px 4px rgba(0,0,0,.08);
        display: flex;
        align-items: center;
        gap: 16px;
        border: 1px solid var(--gray-300);
    }

    .kpi-icon {
        width: 50px;
        height: 50px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
        flex-shrink: 0;
    }

    .kpi-icon.red {
        background: #fee2e2;
        color: var(--primary);
    }

    .kpi-icon.green {
        background: #d1fae5;
        color: var(--success);
    }

    .kpi-icon.yellow {
        background: #fff3cd;
        color: #b58105;
    }

    .kpi-icon.gray {
        background: #e9ecef;
        color: var(--gray-700);
    }

    .kpi-info .label {
        font-size: .78rem;
        color: #6b7280;
        font-weight: 500;
        margin-bottom: 2px;
    }

    .kpi-info .value {
        font-size: 1.35rem;
        font-weight: 700;
        color: var(--gray-900);
    }

    .kpi-info .sub {
        font-size: .75rem;
        color: #9ca3af;
        margin-top: 2px;
    }

    /* ===== SECTION GRID ===== */
    .section-grid {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 20px;
        margin-bottom: 24px;
    }

    @@media (max-width:900px) {
        .section-grid {
            grid-template-columns: 1fr;
        }
    }

    /* ===== CARD PANEL ===== */
    .panel {
        background: var(--white);
        border-radius: 14px;
        box-shadow: 0 1px 4px rgba(0,0,0,.08);
        overflow: hidden;
        border: 1px solid var(--gray-300);
    }

    .panel-head {
        padding: 16px 20px 12px;
        border-bottom: 1px solid var(--gray-200);
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .panel-head h2 {
        margin: 0;
        font-size: 1rem;
        font-weight: 700;
        color: var(--gray-900);
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .panel-head a {
        font-size: .8rem;
        color: var(--primary);
        text-decoration: none;
        font-weight: 500;
    }

    .panel-head a:hover {
        text-decoration: underline;
        color: var(--primary-dark);
    }

    /* ===== TABLE ===== */
    .dash-table {
        width: 100%;
        border-collapse: collapse;
    }

    .dash-table th {
        background: var(--gray-50);
        padding: 10px 14px;
        font-size: .75rem;
        font-weight: 600;
        color: #6b7280;
        text-transform: uppercase;
        letter-spacing: .04em;
        text-align: left;
        border-bottom: 1px solid var(--gray-200);
    }

    .dash-table td {
        padding: 11px 14px;
        font-size: .85rem;
        color: var(--gray-700);
        border-bottom: 1px solid var(--gray-100);
        vertical-align: middle;
    }

    .dash-table tr:last-child td {
        border-bottom: none;
    }

    .dash-table tr:hover td {
        background: #fcfcfc;
    }

    /* ===== BADGES ===== */
    .badge-pill {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 20px;
        font-size: .72rem;
        font-weight: 600;
    }

    .badge-success {
        background: #d1fae5;
        color: #065f46;
    }

    .badge-warning {
        background: #fff3cd;
        color: #92400e;
    }

    .badge-info {
        background: #ffe5e5;
        color: var(--primary-dark);
    }

    .badge-danger {
        background: #fee2e2;
        color: #991b1b;
    }

    .badge-gray {
        background: #f3f4f6;
        color: #374151;
    }

    /* ===== LOW STOCK LIST ===== */
    .stock-list {
        padding: 8px 0;
    }

    .stock-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 20px;
        border-bottom: 1px solid var(--gray-100);
    }

    .stock-item:last-child {
        border-bottom: none;
    }

    .stock-item .name {
        font-size: .85rem;
        font-weight: 600;
        color: var(--gray-900);
    }

    .stock-item .brand {
        font-size: .75rem;
        color: #9ca3af;
    }

    .stock-left {
        font-size: .85rem;
        font-weight: 700;
        color: var(--danger);
        background: #fee2e2;
        border-radius: 8px;
        padding: 2px 10px;
        white-space: nowrap;
    }

    .stock-left.yellow-text {
        color: #92400e;
        background: #fff3cd;
    }

    /* ===== TOP PRODUCT ===== */
    .rank-no {
        width: 24px;
        height: 24px;
        border-radius: 50%;
        background: var(--primary);
        color: var(--white);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: .72rem;
        font-weight: 700;
        flex-shrink: 0;
    }

    .rank-no.gold {
        background: #d97706;
    }

    .rank-no.silver {
        background: #6b7280;
    }

    .rank-no.bronze {
        background: #92400e;
    }

    .top-product-name {
        font-weight: 600;
        font-size: .84rem;
    }

    .top-product-sub,
    .top-product-revenue {
        font-size: .74rem;
        color: #9ca3af;
    }

    .top-product-sold {
        font-weight: 700;
        color: var(--primary);
    }
</style>

<!-- ===== HEADER ===== -->
<div class="dash-header">
    <div>
        <h1>
            <i class="bi bi-speedometer2"></i>
            <span>Dashboard</span>
        </h1>
        <p>ระบบจัดการร้านขายเครื่องใช้ไฟฟ้า · อัปเดต @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</p>
    </div>
    <span class="badge-staff">
        <i class="bi bi-person-badge"></i>
        <span>พนักงาน</span>
    </span>
</div>

<div class="dash-body">

    <!-- ===== KPI CARDS ===== -->
    <div class="kpi-grid">
        <div class="kpi-card">
            <div class="kpi-icon red"><i class="bi bi-cash-stack"></i></div>
            <div class="kpi-info">
                <div class="label">ยอดขายวันนี้</div>
                <div class="value">฿@Model.TotalSaleToday.ToString("N0")</div>
                <div class="sub">บาท</div>
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-icon green"><i class="bi bi-graph-up-arrow"></i></div>
            <div class="kpi-info">
                <div class="label">ยอดขายเดือนนี้</div>
                <div class="value">฿@Model.TotalSaleThisMonth.ToString("N0")</div>
                <div class="sub">บาท</div>
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-icon yellow"><i class="bi bi-box-seam"></i></div>
            <div class="kpi-info">
                <div class="label">ออเดอร์วันนี้</div>
                <div class="value">@Model.TotalOrderToday</div>
                <div class="sub">รายการ · รอดำเนินการ @Model.TotalOrderPending</div>
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-icon red"><i class="bi bi-exclamation-triangle"></i></div>
            <div class="kpi-info">
                <div class="label">สินค้าใกล้หมด</div>
                <div class="value">@Model.LowStockCount</div>
                <div class="sub">หมดสต็อก @Model.OutOfStockCount รายการ</div>
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-icon gray"><i class="bi bi-cart3"></i></div>
            <div class="kpi-info">
                <div class="label">สินค้าทั้งหมด</div>
                <div class="value">@Model.TotalProduct</div>
                <div class="sub">รายการ</div>
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-icon gray"><i class="bi bi-people"></i></div>
            <div class="kpi-info">
                <div class="label">ลูกค้าทั้งหมด</div>
                <div class="value">@Model.TotalCustomer.ToString("N0")</div>
                <div class="sub">ใหม่เดือนนี้ +@Model.NewCustomerThisMonth</div>
            </div>
        </div>
    </div>

    <!-- ===== ออเดอร์ล่าสุด + สินค้าขายดี ===== -->
    <div class="section-grid">

        <!-- ออเดอร์ล่าสุด -->
        <div class="panel">
            <div class="panel-head">
                <h2>
                    <i class="bi bi-receipt-cutoff"></i>
                    <span>ออเดอร์ล่าสุด</span>
                </h2>
                <a asp-action="OrderList" asp-controller="Electrical">ดูทั้งหมด →</a>
            </div>
            <table class="dash-table">
                <thead>
                    <tr>
                        <th>เลขที่ออเดอร์</th>
                        <th>ลูกค้า</th>
                        <th>วันที่</th>
                        <th>ยอดรวม</th>
                        <th>สถานะออเดอร์</th>
                        <th>ชำระเงิน</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in Model.RecentOrders)
                    {
                        <tr>
                            <td><strong>@o.OrderNo</strong></td>
                            <td>@o.CustomerName</td>
                            <td>@o.OrderDate.ToString("dd/MM/yy")</td>
                            <td>฿@o.TotalPrice.ToString("N0")</td>
                            <td>
                                @{
                                    string oBadge = o.OrderStatus switch {
                                        "กำลังจัดส่ง" => "badge-info",
                                        "จัดส่งแล้ว"  => "badge-success",
                                        _              => "badge-warning"
                                    };
                                }
                                <span class="badge-pill @oBadge">@o.OrderStatus</span>
                            </td>
                            <td>
                                <span class="badge-pill @(o.PaymentStatus == "จ่ายแล้ว" ? "badge-success" : "badge-danger")">
                                    @o.PaymentStatus
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- สินค้าขายดี -->
        <div class="panel">
            <div class="panel-head">
                <h2>
                    <i class="bi bi-trophy"></i>
                    <span>สินค้าขายดี</span>
                </h2>
                <a asp-action="ProductList" asp-controller="Electrical">ดูสต็อก →</a>
            </div>
            <table class="dash-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>สินค้า</th>
                        <th>ขายได้</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int rank = 1; }
                    @foreach (var p in Model.TopProducts)
                    {
                        string rankClass = rank == 1 ? "gold" : rank == 2 ? "silver" : rank == 3 ? "bronze" : "";
                        <tr>
                            <td><span class="rank-no @rankClass">@rank</span></td>
                            <td>
                                <div class="top-product-name">@p.ProductName</div>
                                <div class="top-product-sub">@p.Brand · @p.Category</div>
                            </td>
                            <td>
                                <div class="top-product-sold">@p.SoldQty ชิ้น</div>
                                <div class="top-product-revenue">฿@p.Revenue.ToString("N0")</div>
                            </td>
                        </tr>
                        rank++;
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- ===== สินค้าใกล้หมดสต็อก ===== -->
    <div class="panel">
        <div class="panel-head">
            <h2>
                <i class="bi bi-exclamation-circle"></i>
                <span>สินค้าใกล้หมดสต็อก</span>
            </h2>
            <a asp-action="ProductList" asp-controller="Electrical">จัดการสต็อก →</a>
        </div>
        <div class="stock-list">
            @foreach (var s in Model.LowStockProducts)
            {
                bool critical = s.StockLeft <= 2;
                <div class="stock-item">
                    <div>
                        <div class="name">@s.ProductName</div>
                        <div class="brand">@s.Brand · @s.Category</div>
                    </div>
                    <span class="stock-left @(critical ? "" : "yellow-text")">
                        เหลือ @s.StockLeft @s.Unit
                    </span>
                </div>
            }
        </div>
    </div>

</div>