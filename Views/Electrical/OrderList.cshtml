@model List<_66076431_natalee.ViewModels.OrderListItemViewModel>
@{
    Layout = "_BraLayout";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<style>
    body {
        background: #f5f5f5;
        font-family: 'Segoe UI', sans-serif;
        color: #212529;
    }

    .dash-header {
        background: linear-gradient(135deg, #ed1c24, #c81017);
        color: #fff;
        padding: 24px 32px 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        box-shadow: 0 2px 8px rgba(0,0,0,.18);
        border-radius: 0 0 16px 16px;
        margin-bottom: 24px;
    }

    .dash-header h1 {
        margin: 0;
        font-size: 1.5rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .dash-header p {
        margin: 4px 0 0;
        font-size: .85rem;
        opacity: .9;
    }

    .badge-staff {
        background: rgba(255,255,255,.15);
        border: 1px solid rgba(255,255,255,.35);
        border-radius: 20px;
        padding: 6px 14px;
        font-size: .8rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .order-card {
        border: 1px solid #e9ecef;
        border-radius: 16px;
        box-shadow: 0 2px 10px rgba(0,0,0,.06);
        overflow: hidden;
        background: #fff;
    }

    .table {
        margin-bottom: 0;
    }

    .table thead th {
        background: #f8f9fa;
        color: #495057;
        font-size: .9rem;
        font-weight: 700;
        border-bottom: 1px solid #dee2e6;
        white-space: nowrap;
        text-align: center;
    }

    .table tbody td {
        vertical-align: middle;
        text-align: center;
    }

    .table tbody tr:hover {
        background: #fff8f8;
    }

    .slip-thumb {
        width: 70px;
        height: 70px;
        object-fit: cover;
        border-radius: 10px;
        border: 1px solid #ddd;
        box-shadow: 0 2px 6px rgba(0,0,0,.08);
    }

    .price-text {
        font-weight: 700;
        color: #ed1c24;
    }

    .action-group {
        display: flex;
        gap: 6px;
        justify-content: center;
        flex-wrap: nowrap;
        align-items: center;
    }

    .btn-action {
        border-radius: 999px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 5px 10px;
        font-size: .8rem;
        white-space: nowrap;
    }

    .btn-detail {
        background: #0d6efd;
        border: none;
        color: #fff;
    }

    .btn-detail:hover {
        background: #0b5ed7;
        color: #fff;
    }

    .btn-approve {
        background: #198754;
        border: none;
        color: #fff;
    }

    .btn-approve:hover {
        background: #157347;
        color: #fff;
    }

    @@media (max-width: 768px) {
        .dash-header {
            padding: 20px 18px 18px;
            flex-direction: column;
            align-items: flex-start;
            gap: 12px;
        }

        .dash-header h1 {
            font-size: 1.25rem;
        }
    }
</style>

<div class="dash-header">
    <div>
        <h1>
            <i class="bi bi-receipt"></i>
            <span>รายการออเดอร์ (การเงิน)</span>
        </h1>
        <p>@DateTime.Now.ToString("dd/MM/yyyy HH:mm")</p>
    </div>
    <span class="badge-staff">
        <i class="bi bi-person-badge"></i>
        <span>พนักงาน</span>
    </span>
</div>

<div class="card order-card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th>เลขออเดอร์</th>
                        <th>ชื่อลูกค้า</th>
                        <th>จำนวนสินค้า</th>
                        <th>ยอดชำระ</th>
                        <th>สลิป</th>
                        <th>สถานะการชำระเงิน</th>
                        <th style="min-width:230px;">จัดการ</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.OrderNo</td>
                                <td>@item.CustomerName</td>
                                <td>@item.ItemCount รายการ</td>
                                <td class="price-text">฿@item.TotalPrice.ToString("N0")</td>

                                <td>
                                    @if (!string.IsNullOrEmpty(item.SlipImage))
                                    {
                                        <a href="~/slips/@item.SlipImage" target="_blank">
                                            <img src="~/slips/@item.SlipImage" class="slip-thumb" />
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">ไม่มีสลิป</span>
                                    }
                                </td>

                                <td>
                                    <span class="badge bg-warning text-dark">@item.PaymentStatus</span>
                                </td>

                                <td>
                                    @if (item.OrderStatus != "ยกเลิก")
                                    {
                                        <div class="d-flex gap-2">
                                            <a asp-controller="Electrical" asp-action="OrderDetail" asp-route-orderId="@item.OrderId"
                                                class="btn btn-sm btn-detail btn-action justify-content-center"
                                                style="width:36px; padding:5px 0;">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-controller="Electrical" asp-action="ApproveOrder" asp-route-orderId="@item.OrderId"
                                                class="btn btn-sm btn-approve btn-action flex-fill justify-content-center">
                                                <i class="bi bi-check-circle"></i>
                                                <span>อนุมัติ</span>
                                            </a>
                                            <button class="btn btn-sm btn-danger btn-action flex-fill justify-content-center"
                                                    onclick="openRejectModal(@item.OrderId)">
                                                <i class="bi bi-x-circle"></i>
                                                <span>ปฏิเสธ</span>
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="d-flex gap-2">
                                            <a asp-controller="Electrical" asp-action="OrderDetail" asp-route-orderId="@item.OrderId"
                                                class="btn btn-sm btn-detail btn-action flex-fill justify-content-center">
                                                <i class="bi bi-eye"></i>
                                                <span>รายละเอียด</span>
                                            </a>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">
                                ยังไม่มีออเดอร์ที่รอตรวจสอบ
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <form method="post" asp-controller="Electrical" asp-action="ReplyOrder">
                <div class="modal-header">
                    <h5 class="modal-title">ไม่อนุมัติออเดอร์</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">

                    <input type="hidden" name="orderId" id="modalOrderId" />

                    <div class="mb-3">
                        <label class="form-label">ข้อความถึงลูกค้า</label>
                        <textarea name="note" class="form-control" rows="3" placeholder="เช่น สลิปไม่ตรง กรุณาส่งใหม่"></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">สถานะ</label>
                        <select name="status" class="form-select">
                            <option value="ยกเลิก">ยกเลิก (ไม่อนุมัติ)</option>
                            <option value="รอตรวจสอบ">รอตรวจสอบอีกครั้ง</option>
                        </select>
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="submit" class="btn btn-danger">ยืนยันไม่อนุมัติ</button>
                </div>
            </form>

        </div>
    </div>
</div>

<script>
    function openRejectModal(orderId) {
        document.getElementById("modalOrderId").value = orderId;

        var modal = new bootstrap.Modal(document.getElementById('rejectModal'));
        modal.show();
    }
</script>