@model _66076431_natalee.ViewModels.HomeProductItem
@{
    Layout = "_BraLayout2";
}

<style>
    :root {
        --main-red: #ed1c24;
        --dark-red: #c81017;
        --soft-bg: #f8f9fa;
        --border: #e9ecef;
        --text-dark: #212529;
        --text-muted: #6c757d;
    }

    body {
        background-color: var(--soft-bg);
        color: var(--text-dark);
        font-family: 'Segoe UI', sans-serif;
    }

    .product-container {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 6px 18px rgba(0,0,0,0.06);
    }

    .product-image-wrap {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 16px;
    }

    .product-image {
        border-radius: 12px;
        transition: .2s ease;
        max-height: 420px;
        object-fit: contain;
    }

    .product-image:hover {
        transform: scale(1.02);
    }

    .product-category {
        display: inline-block;
        font-size: .85rem;
        color: var(--main-red);
        background: #fff1f1;
        border: 1px solid #ffd9db;
        border-radius: 999px;
        padding: 4px 10px;
    }

    .product-title {
        font-weight: 700;
        color: var(--text-dark);
        line-height: 1.4;
    }

    .product-price {
        color: var(--main-red);
        font-size: 1.75rem;
        font-weight: 700;
    }

    .product-old-price {
        color: var(--text-muted);
        font-size: 1rem;
    }

    .price-box {
        border-top: 1px solid var(--border);
        border-bottom: 1px solid var(--border);
        padding: 16px 0;
    }

    .qty-label {
        font-weight: 600;
    }

    .qty-input {
        width: 110px;
        border-radius: 12px;
    }

    .btn-cart {
        background: #6c757d;
        color: #fff;
        border: none;
        font-weight: 600;
        border-radius: 999px;
        padding: 10px 22px;
    }

    .btn-cart:hover {
        background: #5a6268;
        color: #fff;
    }

    .btn-buy {
        background: var(--main-red);
        color: #fff;
        border: none;
        font-weight: 600;
        border-radius: 999px;
        padding: 10px 22px;
    }

    .btn-buy:hover {
        background: var(--dark-red);
        color: #fff;
    }

    .btn-cart:focus,
    .btn-buy:focus,
    .qty-input:focus {
        box-shadow: 0 0 0 .2rem rgba(237, 28, 36, .12);
        border-color: var(--main-red);
    }

    .product-meta {
        color: var(--text-muted);
        font-size: .95rem;
    }

    @@media (max-width: 768px) {
        .product-container {
            padding: 18px;
        }

        .product-price {
            font-size: 1.5rem;
        }

        .action-group {
            flex-direction: column;
        }

        .action-group .btn {
            width: 100%;
        }
    }
</style>

<div class="container mt-4 mb-4">
    <div class="product-container">

        @if (Model == null)
        {
            <p class="text-muted mb-0">ไม่พบสินค้า</p>
        }
        else
        {
            <div class="row g-4 align-items-start">

                <!-- รูป -->
                <div class="col-md-5">
                    <div class="product-image-wrap text-center">
                        <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "https://placehold.co/500x400/eee/555?text=No+Image" : Model.ImageUrl)"
                            class="img-fluid product-image"
                            onerror="this.src='https://placehold.co/500x400/eee/555?text=No+Image'" />
                    </div>
                </div>

                <!-- รายละเอียด -->
                <div class="col-md-7">
                    <div class="mb-2">
                        <span class="product-category">@Model.Category</span>
                    </div>

                    <h4 class="product-title mb-3">
                        @Model.ProductName
                    </h4>

                    <div class="price-box mb-4">
                        @if (Model.DiscountPrice > 0)
                        {
                            <div class="product-old-price mb-1">
                                <del>฿@Model.SellPrice.ToString("N0")</del>
                            </div>
                            <div class="product-price">
                                ฿@Model.DiscountPrice.ToString("N0")
                            </div>
                        }
                        else
                        {
                            <div class="product-price">
                                ฿@Model.SellPrice.ToString("N0")
                            </div>
                        }
                    </div>
                    <div class="mb-4">
                        <label class="form-label qty-label">จำนวน</label>
                        <input type="number" id="qty" value="1" min="1" class="form-control qty-input">
                    </div>
                    
                    <div class="d-flex gap-3 action-group">
                        <a id="btnCart" asp-controller="Electrical" asp-action="AddToCart" asp-route-PID="@Model.ProductId" asp-route-Qty="1"
                            class="btn btn-cart">
                            เพิ่มลงตะกร้า
                        </a>

                        <a id="btnBuy" asp-controller="Electrical" asp-action="BuyNow" asp-route-PID="@Model.ProductId" asp-route-Qty="1"
                            class="btn btn-buy">
                            ซื้อเลย
                        </a>
                    </div>

                </div>
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.Description))
            {
                <div class="mt-4 pt-3" style="border-top:1px solid var(--border)">
                    <h6 class="fw-bold mb-2">รายละเอียดสินค้า</h6>
                    <p class="product-meta">@Model.Description</p>
                </div>
            }
    </div>
</div>

<script>
    document.getElementById('qty')?.addEventListener('input', function () {
        var qty = this.value || 1;
        var pid = '@Model?.ProductId';

        document.getElementById('btnCart').href =
            '/Electrical/AddToCart?PID=' + pid + '&Qty=' + qty;

        document.getElementById('btnBuy').href =
            '/Electrical/BuyNow?PID=' + pid + '&Qty=' + qty;
    });
</script>