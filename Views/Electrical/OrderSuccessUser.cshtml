@{
    Layout = "_BraLayout2";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<style>
    body {
        background: #f5f5f5;
        font-family: 'Segoe UI', sans-serif;
        color: #212529;
    }

    .success-wrapper {
        min-height: calc(100vh - 140px);
        display: flex;
        align-items: flex-start;
        justify-content: center;
        padding-top: 48px;
        padding-bottom: 40px;
    }

    .success-card {
        background: #fff;
        border: 1px solid #e9ecef;
        border-radius: 20px;
        box-shadow: 0 6px 18px rgba(0,0,0,.06);
        padding: 36px 28px;
        max-width: 520px;
        width: 100%;
        text-align: center;
    }

    .success-icon {
        width: 88px;
        height: 88px;
        margin: 0 auto 18px;
        border-radius: 50%;
        background: #e9f7ef;
        color: #198754;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.2rem;
    }

    .success-title {
        font-size: 1.8rem;
        font-weight: 700;
        color: #198754;
        margin-bottom: 10px;
    }

    .success-text {
        color: #6c757d;
        margin-bottom: 10px;
    }

    .order-box {
        background: #f8f9fa;
        border: 1px solid #e9ecef;
        border-radius: 14px;
        padding: 16px;
        margin: 22px 0;
    }

    .order-id {
        font-weight: 700;
        color: #ed1c24;
        font-size: 1.1rem;
    }

    .status-badge {
        display: inline-block;
        margin-top: 10px;
        background: #fff3cd;
        color: #856404;
        border-radius: 999px;
        padding: 6px 14px;
        font-size: .9rem;
        font-weight: 600;
    }

    .btn-home {
        background: #ed1c24;
        border: none;
        color: #fff;
        border-radius: 999px;
        padding: 10px 22px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
    }

    .btn-home:hover {
        background: #c81017;
        color: #fff;
    }
</style>

<div class="container success-wrapper">
    <div class="success-card">
        <div class="success-icon">
            <i class="bi bi-check-circle-fill"></i>
        </div>

        <div class="success-title">สั่งซื้อสำเร็จ</div>
        <div class="success-text">ระบบบันทึกคำสั่งซื้อของคุณเรียบร้อยแล้ว</div>

        <div class="order-box">
            <div>เลขออเดอร์</div>
            <div class="order-id">#@ViewBag.OrderId</div>
            <div class="status-badge">รอจัดส่ง</div>
        </div>

        <a asp-controller="Electrical" asp-action="Home" class="btn-home">
            <i class="bi bi-house-door"></i>
            <span>กลับหน้าหลัก</span>
        </a>
    </div>
</div>