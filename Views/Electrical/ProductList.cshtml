@model IEnumerable<_66076431_natalee.ViewModels.ProductListItemViewModel>
@{
    Layout = "_BraLayout";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<style>
    body {
        background: #f5f5f5;
        color: #212529;
        font-family: 'Segoe UI', sans-serif;
    }

    .dash-header {
        background: linear-gradient(135deg, #ed1c24, #c81017);
        color: #fff;
        padding: 24px 32px 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        box-shadow: 0 2px 8px rgba(0,0,0,.18);
        border-radius: 0 0 16px 16px;
        margin-bottom: 24px;
    }

    .dash-header h1 {
        margin: 0;
        font-size: 1.5rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .dash-header p {
        margin: 4px 0 0;
        font-size: .85rem;
        opacity: .9;
    }

    .badge-staff {
        background: rgba(255,255,255,.15);
        border: 1px solid rgba(255,255,255,.35);
        border-radius: 20px;
        padding: 6px 14px;
        font-size: .8rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .product-card {
        border: 1px solid #e9ecef;
        border-radius: 16px;
        box-shadow: 0 2px 10px rgba(0,0,0,.06);
        overflow: hidden;
    }

    .table {
        margin-bottom: 0;
    }

    .table thead th {
        background: #f8f9fa;
        color: #495057;
        font-size: .9rem;
        font-weight: 700;
        border-bottom: 1px solid #dee2e6;
        white-space: nowrap;
    }

    .table tbody td {
        vertical-align: middle;
        color: #212529;
    }

    .table tbody tr:hover {
        background: #fff8f8;
    }

    .product-name {
        font-weight: 600;
        color: #212529;
    }

    .price-text {
        font-weight: 700;
        color: #ed1c24;
    }

    .stock-badge {
        display: inline-block;
        min-width: 64px;
        padding: 4px 10px;
        border-radius: 999px;
        font-size: .78rem;
        font-weight: 600;
        background: #f1f3f5;
        color: #495057;
    }

    .action-link {
        text-decoration: none;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .action-edit {
        color: #d97706;
    }

    .action-edit:hover {
        color: #b45309;
        text-decoration: underline;
    }

    .action-delete {
        color: #dc3545;
    }

    .action-delete:hover {
        color: #b02a37;
        text-decoration: underline;
    }

    .btn-add-product {
        background: #ed1c24;
        border: none;
        color: #fff;
        font-weight: 600;
        border-radius: 999px;
        padding: 10px 18px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .btn-add-product:hover {
        background: #c81017;
        color: #fff;
    }

    .btn-add-product:focus,
    .btn-add-product:active {
        background: #c81017;
        color: #fff;
        box-shadow: 0 0 0 .2rem rgba(237,28,36,.15);
    }

    @@media (max-width: 768px) {
        .dash-header {
            padding: 20px 18px 18px;
            flex-direction: column;
            align-items: flex-start;
            gap: 12px;
        }

        .dash-header h1 {
            font-size: 1.25rem;
        }
    }
</style>

<div class="dash-header">
    <div>
        <h1>
            <i class="bi bi-box-seam"></i>
            <span>สินค้าทั้งหมด</span>
        </h1>
        <p>@DateTime.Now.ToString("dd/MM/yyyy HH:mm")</p>
    </div>
    <span class="badge-staff">
        <i class="bi bi-person-badge"></i>
        <span>พนักงาน</span>
    </span>
</div>

<div class="card product-card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered align-middle text-center">
                <thead>
                    <tr>
                        <th>ProductId</th>
                        <th class="text-start">ชื่อสินค้า</th>
                        <th>แบรนด์</th>
                        <th>หมวด</th>
                        <th>ราคาขาย</th>
                        <th>จำนวน</th>
                        <th>หน่วย</th>
                        <th>Edit</th>
                        <th>Delete</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.ProductId</td>
                            <td class="text-start product-name">@item.ProductName</td>
                            <td>@item.Brand</td>
                            <td>@item.Category</td>
                            <td class="price-text">@item.SellPrice</td>
                            <td>
                                <span class="stock-badge">@item.Quantity</span>
                            </td>
                            <td>@item.Unit</td>
                            <td>
                                <a asp-route-PID="@item.ProductId"
                                   asp-action="EditProduct"
                                   asp-controller="Electrical"
                                   class="action-link action-edit">
                                    <i class="bi bi-pencil-square"></i>
                                    <span>Edit</span>
                                </a>
                            </td>
                            <td>
                                <a asp-route-PID="@item.ProductId"
                                   asp-action="DeleteProduct"
                                   asp-controller="Electrical"
                                   class="action-link action-delete">
                                    <i class="bi bi-trash3"></i>
                                    <span>Delete</span>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="text-end mt-3">
            <a asp-controller="Electrical"
               asp-action="AddProduct"
               class="btn btn-add-product">
                <i class="bi bi-plus-circle"></i>
                <span>เพิ่มสินค้า</span>
            </a>
        </div>
    </div>
</div>