@model _66076431_natalee.ViewModels.AddProductViewModel
@{
    Layout = "_BraLayout";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<style>
    body {
        background: #f5f5f5;
        color: #212529;
        font-family: 'Segoe UI', sans-serif;
    }

    .dash-header {
        background: linear-gradient(135deg, #ed1c24, #c81017);
        color: #fff;
        padding: 24px 32px 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        box-shadow: 0 2px 8px rgba(0,0,0,.18);
        border-radius: 0 0 16px 16px;
        margin-bottom: 24px;
    }

    .dash-header h1 {
        margin: 0;
        font-size: 1.5rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .dash-header p {
        margin: 4px 0 0;
        font-size: .85rem;
        opacity: .9;
    }

    .badge-staff {
        background: rgba(255,255,255,.15);
        border: 1px solid rgba(255,255,255,.35);
        border-radius: 20px;
        padding: 6px 14px;
        font-size: .8rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .product-form-card {
        border: 1px solid #e9ecef;
        border-radius: 16px;
        box-shadow: 0 2px 10px rgba(0,0,0,.06);
        overflow: hidden;
        background: #fff;
    }

    .product-form-card .card-body {
        padding: 32px 40px;
    }

    .form-label {
        font-weight: 600;
        color: #212529;
        margin-bottom: 8px;
    }

    .form-control,
    .form-select {
        border-radius: 12px;
        border: 1px solid #ced4da;
        padding: 10px 14px;
        color: #212529;
        box-shadow: none;
    }

    .form-control:focus,
    .form-select:focus {
        border-color: #ed1c24;
        box-shadow: 0 0 0 .2rem rgba(237, 28, 36, .12);
    }

    textarea.form-control {
        resize: vertical;
    }

    .btn-back {
        border-radius: 999px;
        padding: 10px 18px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .btn-save-product {
        background: #ed1c24;
        border: none;
        color: #fff;
        border-radius: 999px;
        padding: 10px 22px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .btn-save-product:hover {
        background: #c81017;
        color: #fff;
    }

    .btn-save-product:focus,
    .btn-save-product:active {
        background: #c81017;
        color: #fff;
        box-shadow: 0 0 0 .2rem rgba(237, 28, 36, .15);
    }

    @@media (max-width: 768px) {
        .dash-header {
            padding: 20px 18px 18px;
            flex-direction: column;
            align-items: flex-start;
            gap: 12px;
        }

        .dash-header h1 {
            font-size: 1.25rem;
        }

        .product-form-card .card-body {
            padding: 22px 18px;
        }
    }
</style>

<div class="dash-header">
    <div>
        <h1>
            <i class="bi bi-plus-circle"></i>
            <span>เพิ่มสินค้า</span>
        </h1>
        <p>@DateTime.Now.ToString("dd/MM/yyyy HH:mm")</p>
    </div>
    <span class="badge-staff">
        <i class="bi bi-person-badge"></i>
        <span>พนักงาน</span>
    </span>
</div>

<div class="card w-100 product-form-card">
    <div class="card-body">

        <form asp-controller="Electrical" asp-action="AddProduct" method="post">

            <div class="mb-3">
                <label class="form-label">ชื่อสินค้า</label>
                <input type="text" asp-for="ProductName" class="form-control" placeholder="กรอกชื่อสินค้า">
            </div>

            <div class="mb-3">
                <label class="form-label">แบรนด์</label>
                <input type="text" asp-for="Brand" class="form-control" placeholder="เช่น Samsung, LG">
            </div>

            <div class="mb-3">
                <label class="form-label">หมวดสินค้า</label>
                <select asp-for="Category" class="form-select">
                    <option value="" disabled selected>เลือกหมวดสินค้า</option>
                    <option>ทีวี</option>
                    <option>แอร์</option>
                    <option>ตู้เย็น</option>
                    <option>เครื่องซักผ้า</option>
                    <option>เครื่องครัว</option>
                    <option>หลอดไฟ</option>
                    <option>อุปกรณ์ไฟฟ้า</option>
                    <option>เครื่องมือช่าง</option>
                </select>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label">จำนวนสินค้า</label>
                    <input type="number" asp-for="Quantity" class="form-control" placeholder="0">
                </div>
                <div class="col-md-6">
                    <label class="form-label">หน่วย</label>
                    <input type="text" asp-for="Unit" class="form-control" placeholder="เช่น เครื่อง / ชิ้น">
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-4">
                    <label class="form-label">ต้นทุน (บาท)</label>
                    <input type="number" asp-for="CostPrice" class="form-control" placeholder="0">
                </div>
                <div class="col-md-4">
                    <label class="form-label">ราคาขาย (บาท)</label>
                    <input type="number" asp-for="SellPrice" class="form-control" placeholder="0">
                </div>
                <div class="col-md-4">
                    <label class="form-label">ราคาลด (บาท)</label>
                    <input type="number" asp-for="DiscountPrice" class="form-control" placeholder="0">
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">การรับประกัน</label>
                <input type="text" asp-for="Warranty" class="form-control" placeholder="เช่น 1 ปี / 3 ปี">
            </div>

            <div class="mb-3">
                <label class="form-label">รายละเอียดสินค้า</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            </div>

            <div class="mb-4">
                <label class="form-label">รูปสินค้า</label>
                <input type="file" asp-for="ImageFile" class="form-control" accept="image/*">
            </div>

            <div class="d-flex justify-content-between mt-4 flex-wrap gap-2">
                <a asp-controller="Electrical" asp-action="ProductList" class="btn btn-secondary btn-back">
                    <i class="bi bi-arrow-left"></i>
                    <span>ย้อนกลับ</span>
                </a>

                <button type="submit" class="btn btn-save-product">
                    <i class="bi bi-floppy"></i>
                    <span>บันทึกสินค้า</span>
                </button>
            </div>

        </form>
    </div>
</div>