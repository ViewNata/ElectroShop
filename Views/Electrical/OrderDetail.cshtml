@model List<_66076431_natalee.ViewModels.OrderDetailViewModel>
@{
    Layout = "_BraLayout";
    var head = Model.FirstOrDefault();
    int no = 1;
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<style>
    body {
        background: #f5f5f5;
        color: #212529;
        font-family: 'Segoe UI', sans-serif;
    }

    .dash-header {
        background: linear-gradient(135deg, #ed1c24, #c81017);
        color: #fff;
        padding: 24px 32px 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        box-shadow: 0 2px 8px rgba(0,0,0,.18);
        border-radius: 0 0 16px 16px;
        margin-bottom: 24px;
    }

    .dash-header h1 {
        margin: 0;
        font-size: 1.5rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .dash-header p {
        margin: 4px 0 0;
        font-size: .85rem;
        opacity: .9;
    }

    .detail-card {
        border: 1px solid #e9ecef;
        border-radius: 16px;
        box-shadow: 0 2px 10px rgba(0,0,0,.06);
        overflow: hidden;
        background: #fff;
    }

    .detail-card .card-header {
        background: #f8f9fa;
        color: #212529;
        font-weight: 700;
        border-bottom: 1px solid #e9ecef;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .slip-image {
        max-width: 300px;
        border-radius: 12px;
        border: 1px solid #ddd;
        box-shadow: 0 2px 8px rgba(0,0,0,.08);
    }

    .table {
        margin-bottom: 0;
    }

    .table thead th {
        background: #f8f9fa;
        color: #495057;
        font-size: .9rem;
        font-weight: 700;
        border-bottom: 1px solid #dee2e6;
        white-space: nowrap;
    }

    .table tbody td {
        vertical-align: middle;
        color: #212529;
    }

    .table tbody tr:hover {
        background: #fff8f8;
    }

    .summary-box {
        background: #fff;
        border: 1px solid #e9ecef;
        border-radius: 16px;
        box-shadow: 0 2px 10px rgba(0,0,0,.06);
        padding: 18px 20px;
        min-width: 280px;
    }

    .summary-total {
        color: #ed1c24;
    }

    .btn-back-order {
        border-radius: 999px;
        padding: 10px 18px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .order-meta strong,
    .customer-info strong {
        color: #212529;
    }

    @@media (max-width: 768px) {
        .dash-header {
            padding: 20px 18px 18px;
        }

        .dash-header h1 {
            font-size: 1.25rem;
        }

        .bottom-action-wrap {
            flex-direction: column;
            align-items: stretch !important;
            gap: 16px;
        }

        .summary-box {
            width: 100%;
            min-width: auto;
        }
    }
</style>

<div class="dash-header">
    <div>
        <h1>
            <i class="bi bi-file-earmark-text"></i>
            <span>รายละเอียดออเดอร์</span>
        </h1>
        <p>@DateTime.Now.ToString("dd/MM/yyyy HH:mm")</p>
    </div>
</div>

@if (head != null)
{
    <div class="card detail-card mb-4">
        <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-3 order-meta">
            <div>
                <strong>เลขออเดอร์:</strong> @head.OrderNo <br />
                <strong>วันที่สั่งซื้อ:</strong> @head.OrderDate.ToString("dd/MM/yyyy HH:mm")
            </div>
            <div>
                <span class="badge bg-success fs-6">@head.PaymentStatus</span>
            </div>
        </div>
    </div>

    <div class="card detail-card mb-4">
        <div class="card-header">
            <i class="bi bi-person"></i>
            <span>ข้อมูลลูกค้า</span>
        </div>
        <div class="card-body customer-info">
            <p><strong>ชื่อ:</strong> @head.CustomerName</p>
            <p><strong>เบอร์โทร:</strong> @head.Phone</p>
            <p><strong>ที่อยู่:</strong> @head.Address</p>
            <p><strong>ขนส่ง:</strong> @head.ShippingMethod</p>
            <p><strong>การชำระเงิน:</strong> @head.PaymentMethod</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(head.SlipImage))
    {
        <div class="card detail-card mb-4">
            <div class="card-header">
                <i class="bi bi-receipt"></i>
                <span>สลิปการชำระเงิน</span>
            </div>
            <div class="card-body">
                <a href="~/slips/@head.SlipImage" target="_blank">
                    <img src="~/slips/@head.SlipImage" class="slip-image" />
                </a>
            </div>
        </div>
    }

    <div class="card detail-card mb-4">
        <div class="card-header">
            <i class="bi bi-box-seam"></i>
            <span>รายการสินค้า</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered m-0">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>ชื่อสินค้า</th>
                            <th>จำนวน</th>
                            <th>ราคาต่อหน่วย</th>
                            <th>ราคารวม</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@no</td>
                                <td>@item.ProductName</td>
                                <td>@item.Quantity</td>
                                <td>฿@item.UnitPrice.ToString("N0")</td>
                                <td>฿@item.TotalPrice.ToString("N0")</td>
                            </tr>
                            no++;
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center bottom-action-wrap">
        <a asp-controller="Electrical" asp-action="OrderList" class="btn btn-secondary btn-back-order">
            <i class="bi bi-arrow-left"></i>
            <span>กลับไปหน้าออเดอร์</span>
        </a>

        <div class="summary-box text-end">
            <div>ยอดก่อนลด: ฿@head.SubTotal.ToString("N0")</div>
            <div>ส่วนลด: ฿@head.Discount.ToString("N0")</div>
            <div class="fw-bold fs-5 mb-3 summary-total">
                รวมทั้งหมด: ฿@((head.SubTotal - head.Discount).ToString("N0"))
            </div>
        </div>
    </div>
}