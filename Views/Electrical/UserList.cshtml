@model IEnumerable<_66076431_natalee.ViewModels.UserListItemViewModel>
@{
    Layout = "_BraLayout";
}
@* UserList.cshtml *@


<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<style>
    body {
        background: #f5f5f5;
        font-family: 'Segoe UI', sans-serif;
        color: #212529;
    }

    /* ===== HEADER ===== */
    .dash-header {
        background: linear-gradient(135deg, #ed1c24, #c81017);
        color: #fff;
        padding: 24px 32px 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        box-shadow: 0 2px 8px rgba(0,0,0,.18);
        border-radius: 0 0 16px 16px;
        margin-bottom: 24px;
    }

    .dash-header h1 {
        margin: 0;
        font-size: 1.5rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .dash-header p {
        margin: 4px 0 0;
        font-size: .85rem;
        opacity: .9;
    }

    .badge-staff {
        background: rgba(255,255,255,.15);
        border: 1px solid rgba(255,255,255,.35);
        border-radius: 20px;
        padding: 6px 14px;
        font-size: .8rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    /* ===== CARD ===== */
    .user-card {
        border: 1px solid #e9ecef;
        border-radius: 16px;
        box-shadow: 0 2px 10px rgba(0,0,0,.06);
        overflow: hidden;
        background: #fff;
    }

    .user-item {
        transition: .2s;
    }

    .user-item:hover {
        background: #fff8f8;
    }

    .user-name {
        font-weight: 600;
        color: #212529;
    }

    .user-email {
        font-size: .8rem;
        color: #6c757d;
    }

    .action-link {
        text-decoration: none;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .action-edit {
        color: #d97706;
    }

    .action-edit:hover {
        color: #b45309;
        text-decoration: underline;
    }

    .action-delete {
        color: #dc3545;
    }

    .action-delete:hover {
        color: #b02a37;
        text-decoration: underline;
    }

    /* ===== ADD BUTTON ===== */
    .btn-add-user {
        background: #ed1c24;
        border: none;
        color: #fff;
        width: 48px;
        height: 48px;
        border-radius: 50%;
        font-size: 20px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .btn-add-user:hover {
        background: #c81017;
        color: #fff;
    }

    @@media (max-width: 768px) {
        .dash-header {
            padding: 20px 18px;
            flex-direction: column;
            align-items: flex-start;
            gap: 10px;
        }

        .dash-header h1 {
            font-size: 1.25rem;
        }
    }
</style>

<div class="dash-header">
    <div>
        <h1>
            <i class="bi bi-people"></i>
            <span>รายชื่อลูกค้า</span>
        </h1>
        <p>@DateTime.Now.ToString("dd/MM/yyyy HH:mm")</p>
    </div>
    <span class="badge-staff">
        <i class="bi bi-person-badge"></i>
        <span>ลูกค้า</span>
    </span>
</div>

<div class="card user-card w-100">
    <div class="card-body px-4">

        @foreach (var item in Model)
        {
            <div class="d-flex align-items-center border-bottom py-3 user-item">

                <div class="flex-grow-1">
                    <div class="user-name">@item.ListName</div>
                    <div class="user-email">@item.ListEmail</div>
                </div>

                <div class="me-4">
                    @item.ListPhoneNumber
                </div>

                <div class="d-flex gap-3">
                    <a asp-controller="Electrical" asp-action="EditUser" asp-route-UID="@item.ListId"
                        class="action-link action-edit">
                        <i class="bi bi-pencil-square"></i>
                        <span>แก้ไข</span>
                    </a>

                    <a asp-controller="Electrical" asp-action="DeleteUser" asp-route-UID="@item.ListId"
                        class="action-link action-delete"
                        onclick="return confirm('คุณต้องการลบพนักงานคนนี้หรือไม่?');">
                        <i class="bi bi-trash3"></i>
                        <span>ลบ</span>
                    </a>
                </div>

            </div>
        }

        <div class="text-end mt-4">
            <a asp-controller="Electrical" asp-action="Register"
                class="btn btn-add-user">
                <i class="bi bi-plus-lg"></i>
            </a>
        </div>

    </div>
</div>

