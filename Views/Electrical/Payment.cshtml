@model _66076431_natalee.ViewModels.OrderListItemViewModel
@{
    Layout = "_BraLayout2";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<style>
    body {
        background: #f5f5f5;
        font-family: 'Segoe UI', sans-serif;
        color: #212529;
    }

    .payment-card {
        max-width: 700px;
        margin: 40px auto;
        padding: 24px;
        background: #fff;
        border-radius: 16px;
        border: 1px solid #e9ecef;
        box-shadow: 0 6px 18px rgba(0,0,0,.06);
    }

    .payment-title {
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .payment-title i {
        color: #ed1c24;
    }

    .order-no {
        color: #6c757d;
    }

    .price {
        color: #ed1c24;
        font-size: 2rem;
        font-weight: 700;
    }

    .qr-box {
        text-align: center;
        background: #f8f9fa;
        border-radius: 16px;
        padding: 20px;
        border: 1px solid #e9ecef;
    }

    .qr-box img {
        border-radius: 12px;
        border: 1px solid #ddd;
        margin-bottom: 10px;
    }

    .bank-info {
        background: #fff;
        border: 1px solid #e9ecef;
        border-radius: 12px;
        padding: 16px;
    }

    .bank-info p {
        margin: 4px 0;
    }

    .btn-submit-slip {
        background: #ed1c24;
        border: none;
        color: #fff;
        font-weight: 600;
        border-radius: 999px;
        padding: 10px 18px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .btn-submit-slip:hover {
        background: #c81017;
        color: #fff;
    }

    .btn-submit-slip:focus {
        box-shadow: 0 0 0 .2rem rgba(237,28,36,.15);
    }
</style>

<div class="payment-card">

    <!-- Title -->
    <h4 class="payment-title mb-3">
        <i class="bi bi-credit-card"></i>
        <span>ชำระเงิน</span>
    </h4>

    <!-- Order -->
    <p class="order-no">
        เลขออเดอร์: <strong>@Model.OrderNo</strong>
    </p>
    
    <!-- Price -->
    <div class="price mb-4">
        ฿@Model.TotalPrice.ToString("N0")
    </div>

    <!-- QR -->
    <div class="qr-box mb-4">
        <img src="~/images/qr.jpg" width="200" />
        <div class="fw-semibold">พร้อมเพย์: 090-xxx-xxxx</div>
    </div>

    <!-- Bank -->
    <div class="bank-info mb-4">
        <p><strong>ชื่อบัญชี:</strong> บัญชีตัวอย่าง</p>
        <p><strong>ธนาคาร:</strong> กสิกรไทย</p>
        <p><strong>เลขบัญชี:</strong> XXX-X-XXXXX-X</p>
    </div>

    <!-- Upload -->
    <form asp-action="UploadSlip" method="post" enctype="multipart/form-data">
        <input type="hidden" name="orderId" value="@Model.OrderId" />

        <div class="mb-3">
            <label class="form-label fw-semibold">อัปโหลดสลิป</label>
            <input type="file" name="slipFile" class="form-control" required />
        </div>

        <div class="text-end">
            <button type="submit" class="btn btn-submit-slip">
                <i class="bi bi-upload"></i>
                <span>ยืนยันการชำระเงิน</span>
            </button>
        </div>
    </form>

</div>