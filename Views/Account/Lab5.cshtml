@* แบบคือแบบ 1:N หรือ List *@
@model IEnumerable<_66076431_natalee.ViewModels.LabUserViewModel>
<h1> Lab 5</h1>
<div>
  @* @Model.UserId
  @Model.Name
  @Model.LastName
  @Model.Address
  @Model.Age
  @Model.Height
  @Model.Weight *@


  <table class="table table-bordered">
    <thead>
      <tr>
        <th>UserId</th>
        <th>Name</th>
        <th>LastName</th>
        <th>Address</th>
        <th>Age</th>
        <th>Height</th>
        <th>Weight</th>
      </tr>
    </thead>

    <tbody>
      @foreach (var item in Model)
      {
        <tr>
          <td>@item.UserId</td>
          <td>@item.Name</td>
          <td>@item.LastName</td>
          <td>@item.Address</td>
          <td>@item.Age</td>
          <td>@item.Height</td>
          <td>@item.Weight</td>
        </tr>
      }
    </tbody>
  </table>

</div>


